# ─── KAIROS environment configuration ─────────────────────────────────────────
# Fill in every REQUIRED value below, then start the bot. The bot refuses to
# start if any required value is missing. NEVER commit this file to git.

# REQUIRED — Your ProjectX / TopstepX username (the one you log into the platform with).
PROJECT_X_USERNAME=

# REQUIRED — Your ProjectX API key. Generate it in the platform's API settings
# (see https://help.topstep.com/en/articles/11187768-topstepx-api-access).
PROJECT_X_API_KEY=

# REQUIRED — The exact ACCOUNT NAME the bot should trade (as shown in the active
# account list, e.g. a Practice or Funded account). KAIROS resolves the numeric ID.
PROJECT_X_ACCOUNT_ID=

# REQUIRED — A long random string of your choosing. Every TradingView alert must
# include this same value in its JSON payload ("secret") or the bot rejects it.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# REQUIRED — A second long random string. Needed to open the web dashboard and
# call any control endpoint. Generate the same way as WEBHOOK_SECRET.
DASHBOARD_TOKEN=

# OPTIONAL — The public HTTPS origin created by your Cloudflare tunnel, without a
# trailing slash (for example https://app.example.com). Used only by start.sh to
# print the exact webhook/dashboard links; the bot itself does not require it.
KAIROS_PUBLIC_URL=

# OPTIONAL — Discord webhook URL for trade notifications.
# Server → Channel → Integrations → Webhooks → New Webhook. Blank = disabled.
DISCORD_WEBHOOK_URL=

# OPTIONAL — Who to ping on A+ / auto-pause Discord alerts:
# "everyone", "here", or a numeric Discord user ID. Blank = post without pinging.
DISCORD_MENTION=

# OPTIONAL — Telegram bot token (from @BotFather) for trade notifications.
# Both Telegram values must be set for Telegram alerts to fire. Blank = disabled.
TELEGRAM_BOT_TOKEN=

# OPTIONAL — The Telegram chat ID the bot should message (your user ID or a group ID).
TELEGRAM_CHAT_ID=
